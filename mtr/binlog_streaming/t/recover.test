--source ../include/have_binsrv.inc

--source ../include/v80_v84_compatibility_defines.inc

# in case of --repeat=N, we need to start from a fresh binary log to make
# this test deterministic
--echo *** Resetting replication at the very beginning of the test.
--disable_query_log
eval $stmt_reset_binary_logs_and_gtids;
--enable_query_log

--echo
--echo *** Determining the first fresh binary log name.
--let $first_binlog = query_get_value($stmt_show_binary_log_status, File, 1)

--echo
--echo *** Creating a simple table and filling it with some data.
CREATE TABLE t1(id INT UNSIGNED NOT NULL AUTO_INCREMENT, PRIMARY KEY(id)) ENGINE=InnoDB;
INSERT INTO t1 VALUES(DEFAULT);

# identifying backend storage type ('file' or 's3')
--source ../include/identify_storage_backend.inc

# creating data directory, configuration file, etc.
--let $binsrv_connect_timeout = 20
--let $binsrv_read_timeout = 60
--let $binsrv_idle_time = 10
--let $binsrv_verify_checksum = TRUE
--let $binsrv_replication_mode = position
--let $binsrv_checkpoint_size = 1
--source ../include/set_up_binsrv_environment.inc

--echo
--echo *** Executing the Binlog Server utility to download all binlog data
--echo *** from the server.
--exec $BINSRV fetch $binsrv_config_file_path > /dev/null

--echo
--echo *** Making a copy of the first binlog metadata file
--let $first_binlog_metadata = $first_binlog.json
--let $saved_binlog_metadata_file = $MYSQL_TMP_DIR/$first_binlog.json
if ($storage_backend == file)
{
  --copy_file $binsrv_storage_path/$first_binlog_metadata $saved_binlog_metadata_file
}
if ($storage_backend == s3)
{
  --exec $aws_cli s3 cp s3://$aws_s3_bucket$binsrv_storage_path/$first_binlog_metadata $saved_binlog_metadata_file > /dev/null
}

--echo
--echo *** Inserting more data to the table.
INSERT INTO t1 VALUES(DEFAULT);

--echo
--echo *** Simulating temporary object presence in the storage.
--let $first_binlog_tmp = $first_binlog.tmp
if ($storage_backend == file)
{
  --copy_file $binsrv_storage_path/$first_binlog $binsrv_storage_path/$first_binlog_tmp
}
if ($storage_backend == s3)
{
  --exec $aws_cli s3 cp s3://$aws_s3_bucket$binsrv_storage_path/$first_binlog s3://$aws_s3_bucket$binsrv_storage_path/$first_binlog_tmp > /dev/null
}

--echo
--echo *** Executing the Binlog Server utility to clean temporary objects and
--echo *** to receive events generated by the second insert.
--exec $BINSRV fetch $binsrv_config_file_path > /dev/null

--echo
--echo *** Checking that the Binlog Server utility removed temporary objects.
--let $assert_text = Binlog storage initialization removed temporary objects ('found' message)
--let $assert_file = $binsrv_log_path
--let $assert_count = 1
--let $assert_select = found temporary storage object '$first_binlog_tmp' left after improper shutdown
--source include/assert_grep.inc
--let $assert_text = Binlog storage initialization removed temporary objects ('removed' message)
--let $assert_select = removed 1 temporary storage object\(s\) left after improper shutdown
--source include/assert_grep.inc

--echo
--echo *** Simulating corrupted storage state by replacing the first binlog
--echo *** metadata file.
if ($storage_backend == file)
{
  --remove_file $binsrv_storage_path/$first_binlog_metadata
  --copy_file $saved_binlog_metadata_file $binsrv_storage_path/$first_binlog_metadata
}
if ($storage_backend == s3)
{
  --exec $aws_cli s3 cp $saved_binlog_metadata_file s3://$aws_s3_bucket$binsrv_storage_path/$first_binlog_metadata > /dev/null
}

--echo
--echo *** Executing the Binlog Server utility to initiate the recovery process.
--exec $BINSRV fetch $binsrv_config_file_path > /dev/null

--echo
--echo *** Checking that the Binlog Server utility recovered the first binlog
--echo *** file.
--let $assert_text = Binlog storage initialization recovered the first binlog file
--let $assert_file = $binsrv_log_path
--let $assert_count = 1
--let $assert_select = recovered binlog file '$first_binlog' by truncating it to the size from the metadata
--source include/assert_grep.inc

--echo
--echo *** Flushing the first binary log and switching to the second one.
FLUSH BINARY LOGS;

--echo
--echo *** Dropping the table.
DROP TABLE t1;

--echo
--echo *** Executing the Binlog Server utility one more time to receive missing
--echo *** events from the first binlog.
--exec $BINSRV fetch $binsrv_config_file_path > /dev/null

--echo
--echo *** Comparing server and downloaded versions of the first binlog file.
--let $local_file = $binlog_base_dir/$first_binlog
--let $storage_object = $binsrv_storage_path/$first_binlog
--source ../include/diff_with_storage_object.inc

--echo
--echo *** Simulating corrupted storage state by replacing the first binlog
--echo *** metadata file which is not the latest one anymore.
if ($storage_backend == file)
{
  --remove_file $binsrv_storage_path/$first_binlog_metadata
  --copy_file $saved_binlog_metadata_file $binsrv_storage_path/$first_binlog_metadata
}
if ($storage_backend == s3)
{
  --exec $aws_cli s3 cp $saved_binlog_metadata_file s3://$aws_s3_bucket$binsrv_storage_path/$first_binlog_metadata > /dev/null
}

--echo
--echo *** Executing the Binlog Server utility to initiate the recovery process
--echo *** but fail because the size mismatch is not in the latest binlog file.
--error 1
--exec $BINSRV fetch $binsrv_config_file_path > /dev/null

--echo
--echo *** Checking that the Binlog Server utility detected unrecoverable
--echo *** storage corruption.
--let $assert_text = Binlog storage initialization discovered unrecoverable state
--let $assert_file = $binsrv_log_path
--let $assert_count = 1
--let $assert_select = size from the binlog metadata does not match the actual binlog size
--source include/assert_grep.inc

# cleaning up
--remove_file $saved_binlog_metadata_file
--source ../include/tear_down_binsrv_environment.inc
